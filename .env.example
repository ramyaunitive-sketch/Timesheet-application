# Copy this file to .env before running the app.

# Port the server listens on.
PORT=3000

# Optional: set the admin's initial password explicitly. If left blank, a
# random one is generated and printed to the server console the first time
# it runs — either way, the admin sets their own password on first login.
ADMIN_DEFAULT_PASSWORD=

# Where the SQLite database file is stored.
DB_PATH=./data/timeflow.db

# Recovery only: if the admin forgets their password, set this to a new
# password, restart the server once, log in, then remove this line again.
ADMIN_RESET_PASSWORD=
